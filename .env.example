# Copy to .env and adjust. Never commit real values.
LORE_ENV=development
LORE_DATABASE_URL=postgresql+psycopg://lore:lore@localhost:5432/lore
LORE_REDIS_URL=redis://localhost:6379/0

# Required for all /api/v1 endpoints (header: X-API-Key)
LORE_API_KEY=change-me

# Where uploaded export archives are stored (outside the repo)
LORE_DATA_DIR=./data

# Import safety limits
LORE_MAX_UPLOAD_BYTES=10737418240
LORE_MAX_MEMBER_BYTES=524288000
LORE_MAX_ARCHIVE_MEMBERS=200000
LORE_MAX_COMPRESSION_RATIO=200

LORE_LOG_LEVEL=INFO
LORE_LOG_JSON=false

# Background processing: "celery" (worker + Redis) or "inline" (run in-process; tests/dev only)
LORE_TASK_BACKEND=celery
LORE_IMPORT_TASK_MAX_RETRIES=8
# A running import whose heartbeat is older than this is considered crashed and is resumed
LORE_IMPORT_HEARTBEAT_STALE_SECONDS=300
LORE_IMPORT_SWEEP_INTERVAL_SECONDS=60
LORE_IMPORT_PENDING_GRACE_SECONDS=120
LORE_BROKER_VISIBILITY_TIMEOUT_SECONDS=21600

# Media processing (local, nothing leaves the machine)
LORE_OCR_LANGUAGES=eng+hin
LORE_WHISPER_MODEL=small
LORE_FRAME_INTERVAL_SECONDS=2
LORE_MAX_FRAMES_PER_VIDEO=45
LORE_MAX_MEDIA_BYTES=524288000

# AI extraction (Copilot SDK). Leave empty to disable automatic extraction after media processing.
LORE_COPILOT_MODEL=claude-haiku-5.5
LORE_COPILOT_GITHUB_TOKEN=

# Processing queue
LORE_PIPELINE_RATE_LIMIT=20/m
LORE_PIPELINE_MAX_ATTEMPTS=5
LORE_AUTO_PROCESS_IMPORTS=false
