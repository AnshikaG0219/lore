# Copy to .env and adjust. Never commit real values.
INSTABRAIN_ENV=development
INSTABRAIN_DATABASE_URL=postgresql+psycopg://instabrain:instabrain@localhost:5432/instabrain
INSTABRAIN_REDIS_URL=redis://localhost:6379/0

# Required for all /api/v1 endpoints (header: X-API-Key)
INSTABRAIN_API_KEY=change-me

# Where uploaded export archives are stored (outside the repo)
INSTABRAIN_DATA_DIR=./data

# Import safety limits
INSTABRAIN_MAX_UPLOAD_BYTES=10737418240
INSTABRAIN_MAX_MEMBER_BYTES=524288000
INSTABRAIN_MAX_ARCHIVE_MEMBERS=200000
INSTABRAIN_MAX_COMPRESSION_RATIO=200

INSTABRAIN_LOG_LEVEL=INFO
INSTABRAIN_LOG_JSON=false

# Background processing: "celery" (worker + Redis) or "inline" (run in-process; tests/dev only)
INSTABRAIN_TASK_BACKEND=celery
INSTABRAIN_IMPORT_TASK_MAX_RETRIES=8
# A running import whose heartbeat is older than this is considered crashed and is resumed
INSTABRAIN_IMPORT_HEARTBEAT_STALE_SECONDS=300
INSTABRAIN_IMPORT_SWEEP_INTERVAL_SECONDS=60
INSTABRAIN_IMPORT_PENDING_GRACE_SECONDS=120
INSTABRAIN_BROKER_VISIBILITY_TIMEOUT_SECONDS=21600

# Media processing (local, nothing leaves the machine)
INSTABRAIN_OCR_LANGUAGES=eng+hin
INSTABRAIN_WHISPER_MODEL=small
INSTABRAIN_FRAME_INTERVAL_SECONDS=2
INSTABRAIN_MAX_FRAMES_PER_VIDEO=45
INSTABRAIN_MAX_MEDIA_BYTES=524288000

# AI extraction (Copilot SDK). Leave empty to disable automatic extraction after media processing.
INSTABRAIN_COPILOT_MODEL=claude-haiku-5.5
INSTABRAIN_COPILOT_GITHUB_TOKEN=
